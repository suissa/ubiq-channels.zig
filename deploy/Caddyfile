# Enable all supported HTTP versions at the TLS edge.
# HTTP/3 requires UDP access on the same port as the HTTPS listener.
{
    servers {
        protocols h1 h2 h3
    }
}

# TLS edge: Caddy negotiates HTTP/3 (QUIC), HTTP/2 (h2), or HTTP/1.1.
# For local development, this uses Caddy's locally trusted internal CA.
# For production, replace localhost with your public DNS name and use public TLS.
https://localhost:8443 {
    tls internal
    reverse_proxy 127.0.0.1:8080 {
        # Flush each upstream write so SSE is streamed instead of buffered.
        flush_interval -1
    }
}

# Explicit plaintext HTTP/1.1 listener for clients that cannot use TLS.
http://localhost:8081 {
    reverse_proxy 127.0.0.1:8080 {
        flush_interval -1
    }
}
