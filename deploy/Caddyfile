# HTTP/2 and HTTP/3 terminate at Caddy; the Zig upstream speaks HTTP/1.1.
{
    servers {
        protocols h1 h2 h3
    }
}

https://localhost:8443 {
    tls internal
    reverse_proxy 127.0.0.1:8080 {
        # Flush each upstream write so SSE is streamed instead of buffered.
        flush_interval -1
    }
}

http://localhost:8081 {
    reverse_proxy 127.0.0.1:8080 {
        flush_interval -1
    }
}
